# App
APP_NAME=triage-backend
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
# по умолчанию docs включены везде, кроме APP_ENV=prod
# ENABLE_DOCS=true

# HTTP
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Security (в prod JWT_SECRET обязателен)
JWT_SECRET=dev-secret-change-me
JWT_TTL_MIN=60

# AI (интеграция позже)
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:8001
AI_TIMEOUT_S=30

# Storage
STORAGE=memory
SEED_ON_START=true
