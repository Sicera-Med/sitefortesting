# App
APP_NAME=triage-backend
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
# по умолчанию docs включены везде, кроме APP_ENV=prod
# ENABLE_DOCS=true

# HTTP
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Security (в prod JWT_SECRET обязателен)
JWT_SECRET=dev-secret-change-me-in-prod-0123456789
JWT_TTL_MIN=60

# AI (интеграция позже)
# Ответы AI — только от сервиса коллег (mock — только для тестов)
AI_PROVIDER=http
AI_BASE_URL=http://localhost:8001
AI_TIMEOUT_S=30
# Автоанализ: опрос новых исследований и повтор при сбое AI
AI_AUTO_ANALYZE=true
AI_POLL_S=3
AI_RETRY_S=30
AI_HIGH_CONFIDENCE=0.7

# Storage
STORAGE=memory
SEED_ON_START=true

# Клиника
CLINIC_TZ=Europe/Moscow
