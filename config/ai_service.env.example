# Токен Hugging Face Inference API — https://huggingface.co/settings/tokens
# Можно несколько через запятую: если у токена кончились кредиты (402), он неверный (401/403)
# или упёрся в лимит (429) — сервис сам возьмёт следующий
HF_TOKEN=
# Модель: одна или несколько через запятую — используется первая (как в test_of_models.py)
MODEL=Qwen/Qwen3-4B-Instruct-2507
