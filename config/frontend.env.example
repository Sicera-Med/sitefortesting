# Frontend (Next.js). Обычно ничего задавать не нужно: браузер ходит в API через сам сайт,
# /api/* проксируется на backend (frontend/next.config.ts).

# Адрес backend для прокси — читается при сборке (next build / docker compose build).
# Локально — http://localhost:8000; в docker-compose — http://backend:8000 (задан там)
BACKEND_INTERNAL_URL=http://localhost:8000

# Необязательно: ходить в API напрямую, минуя прокси (тогда нужен CORS_ORIGINS на backend)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
