# App
APP_NAME=triage-backend
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
# по умолчанию docs включены везде, кроме APP_ENV=prod
# ENABLE_DOCS=true

# HTTP
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Security (в prod JWT_SECRET обязателен)
JWT_SECRET=dev-secret-change-me-in-prod-0123456789
JWT_TTL_MIN=60

# AI (интеграция позже)
# Ответы AI — только от сервиса коллег (mock — только для тестов)
AI_PROVIDER=http
AI_BASE_URL=http://localhost:8001
AI_TIMEOUT_S=120
# Автоанализ: опрос новых исследований и повтор при сбое AI
AI_AUTO_ANALYZE=false
AI_POLL_S=3
AI_RETRY_S=28800
AI_MAX_AUTO_ATTEMPTS=3
AI_SEND_COOLDOWN_S=10
NOTIFY_REMINDERS=true
SITE_URL=https://sicera-ai.onrender.com
AI_HIGH_CONFIDENCE=0.7

# Демо-данные при старте (хранилище — в памяти, до перезапуска)
SEED_ON_START=true

# Клиника
CLINIC_TZ=Europe/Moscow

# Рассылки (services/channels.py). NOTIFY_REAL=false — всё имитируется
NOTIFY_REAL=false
NOTIFY_SMS=true
NOTIFY_EMAIL=true
NOTIFY_OUTBOX_POLL_S=2
NOTIFY_REMIND_COOLDOWN_S=10
# SMSPilot: https://smspilot.ru/my-settings.php?tab=api
SMSPILOT_API_KEY=
SMSPILOT_FROM=
# SMTP Яндекса: ящик и пароль приложения (id.yandex.ru → Безопасность → Пароли приложений)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Демо: телефон и почта, которые получат все пациенты seed
DEMO_CONTACT_PHONE=
DEMO_CONTACT_EMAIL=
